#!/bin/bash
set -eu
: "${TRIM_PKGVAR:?}" "${TRIM_APPDEST:?}"
pidfile="$TRIM_PKGVAR/server.pid"
log="$TRIM_PKGVAR/server.log"
valid() {
 [ -r "$pidfile" ] || return 1
 pid=$(cat "$pidfile")
 case "$pid" in ''|*[!0-9]*) return 1;; esac
 [ "$(readlink "/proc/$pid/exe" 2>/dev/null || :)" = "$(readlink -f "$TRIM_APPDEST/cangzhou-server")" ]
}
case "${1:-}" in
start)
 valid && exit 0
 umask 077
 "$TRIM_APPDEST/cangzhou-server" >> "$log" 2>&1 &
 echo "$!" > "$pidfile"
 sleep 2
 valid || exit 1
 ;;
stop)
 if valid; then
  kill -TERM "$pid"
  for i in $(seq 1 20); do
   valid || break
   sleep 1
  done
  if valid; then echo '服务未能停止；拒绝强制结束，避免遗留备份进程' >&2; exit 1; fi
 fi
 rm -f "$pidfile"
 ;;
status) valid || exit 3;;
*) exit 1;;
esac
